# syntax=docker/dockerfile:1

# 애플리케이션 빌드
# 빌드는 CI 아키텍처에서 실행하고 JAR만 운영 이미지로 전달
FROM --platform=$BUILDPLATFORM gradle:9.4.1-jdk21 AS builder

WORKDIR /workspace

# Gradle 캐시와 빌드 결과를 생성할 수 있도록 권한 변경
RUN chown gradle:gradle /workspace

# 의존성 캐시용 빌드 파일
COPY --chown=gradle:gradle gradlew build.gradle settings.gradle ./
COPY --chown=gradle:gradle gradle ./gradle

USER gradle

# 테스트는 CI에서 실행
RUN chmod +x gradlew \
    && ./gradlew dependencies --no-daemon

COPY --chown=gradle:gradle src ./src

# 실행 JAR 생성
RUN ./gradlew bootJar --no-daemon \
    && JAR_FILE="$(find build/libs -maxdepth 1 -type f -name '*.jar' ! -name '*-plain.jar' -print -quit)" \
    && test -n "$JAR_FILE" \
    && cp "$JAR_FILE" /workspace/app.jar

# 운영 런타임
# t4g.small 배포 이미지는 linux/arm64로 빌드
FROM amazoncorretto:21-al2023-headless AS runtime

WORKDIR /app

# 실행에 필요한 JAR만 복사
COPY --from=builder --chown=10001:10001 /workspace/app.jar /app/app.jar

# root가 아닌 사용자로 실행
USER 10001:10001

# 앱과 Actuator 포트
EXPOSE 8080 8081

STOPSIGNAL SIGTERM

ENTRYPOINT ["java", "-jar", "/app/app.jar"]
